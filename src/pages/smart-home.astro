---

// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
// import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import smarthomephone from "@images/housephone.jpg";
import smarthouse from "@images/smarthouse.jpg";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [

 {
    isRightSection: true,
    title: "Smart Devices for a Smarter Home",
    subTitle:
      "At MidasTech, we offer a range of cutting-edge Smart Home devices to automate, secure, and enhance your living spaces. From smart lighting to thermostats and security systems, our experts help you choose the perfect solutions for your home or business.",
    single: true,
    imgOne: smarthouse,
    imgOneAlt: "Smart home devices",
    
  },
  
  {
    isRightSection: false,
    title: "Smart Home Solutions for Modern Living",
    subTitle:
      "MidasTech brings cutting-edge Smart Home technology to enhance your comfort, security, and energy efficiency. From tailored automation to expert installation, we’re here to transform your space.",
    img: smarthomephone,
    imgAlt: "Smart Home phone app.",
  },

];

const pageTitle: string = `SmartHome | ${SITE.title}`;

---
<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://midastechno.com/smart-home",
   "url": "https://midastechno/smart-home",
    "name": "Smart Home Solutions | MidasTech",
    "description": "Transform your living or workspaces with MidasTech’s Smart Home Solutions. Our certified experts provide seamless integration of IoT devices, smart lighting, thermostats, security systems, and more. Experience unparalleled comfort, energy efficiency, and security – all at your fingertips.",
    "isPartOf":{
    "@type": "WebSite",
    "url": "https://midastechno.com",
    "name": "MidasTech | Smart Home Experts",
    "description": "MidasTech specializes in advanced Smart Home installation and monitoring solutions, bringing you cutting-edge technology for enhanced comfort, energy efficiency, and security for your home or business."
    },
    "inLanguage": "en-US"
  }} >

    <!--MainSection is the introductory section of the page, it also contains a CTA button-->
  <MainSection
    title="Elevate Your Living with Smart Home Technology"
    subTitle="At MidasTech, we offer Reliable, Affordable, and Customizable Smart Home Solutions designed to enhance your comfort, security, and energy efficiency. Tailored to fit your lifestyle and budget."
  />
  
   {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

</MainLayout>